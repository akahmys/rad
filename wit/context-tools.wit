package radcomp:extension;

// `types` (ras-rpc-command et al.) is defined in rad.wit — same package,
// same directory, resolved together by the tooling. context-tools uses to
// the same full RPC surface every other extension does (see AWU 915's
// follow-up: this used to be a bespoke single-variant `command(string)`
// type in its own `radcomp:context-tools` package, whose raw-shell host
// bridge silently ignored `PermissionConfig.fs_read_allow`/`fs_write_allow`
// since it never went through the real permission-checked RPC path).

interface context-tools {
    record message {
        node-id: option<string>,
        role: string,
        content: string,
    }

    record optimization-request {
        messages: list<message>,
        // Maximum number of messages to retain. When the message list exceeds
        // this count, it is windowed down to the first message (the original
        // goal) plus the most recent messages before role-based compaction is
        // applied. `none` disables count-based windowing.
        max-history: option<u32>,
        // Maximum total content characters to retain across the first
        // (goal) message plus the kept tail. Computed by the host from the
        // active LLM endpoint's actual context window, since message count
        // alone is a poor proxy for how much of a small local context
        // window a handful of large tool outputs can consume. When both
        // this and `max-history` are set, whichever produces the smaller
        // (more restrictive) window wins. `none` disables size-based
        // windowing.
        max-content-chars: option<u32>,
    }

    record optimization-response {
        optimized-messages: list<message>,
        summary: string,
    }

    optimize: func(request: optimization-request) -> result<optimization-response, string>;
    get-repo-map: func() -> result<string, string>;
}

world context-tools-extension {
    use types.{ras-rpc-command};

    import host-rpc: func(command: ras-rpc-command) -> result<string, string>;

    export context-tools;
}
